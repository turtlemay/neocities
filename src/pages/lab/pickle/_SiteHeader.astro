<style>
	.siteHeader {
		background: rgba(0, 0, 0, 0.05);
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 10px;
		padding: 2em;
		width: 100%;
		position: relative;

		[role="heading"] {
			margin: 0;
			font: 40pt "Rye";
			color: black;
			line-height: 0.9;
			text-align: center;
			text-transform: uppercase;
			position: relative;
			z-index: 200;

			.text1 {
				font-size: 0.8em;
				color: rgba(100, 0, 0, 0.5);
			}

			.text2 {
				font-size: 0.5em;
				color: rgba(0, 0, 0, 0.25);
			}

			.text3 {
				font-size: 1em;
				color: black;
			}
		}

		.icon {
			font:
				80px "Noto Color Emoji",
				monospace;
			user-select: none;
			display: flex;
			align-items: center;
			justify-content: center;
			position: absolute;
			left: 75px;
			top: 50%;
			filter: hue-rotate(-40deg) opacity(0.25);
			translate: 0% -50%;
			z-index: 100;
		}
	}
</style>

<div class="siteHeader">
	<h1 role="heading">
		<span class="text1">Ask</span>
		<span class="text2">the</span><br />
		<span class="text3">Orickle</span>
	</h1>
	<div class="icon" role="presentation">
		<div>🥒</div>
	</div>
</div>
