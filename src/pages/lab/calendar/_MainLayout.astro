<head>
	<meta charset="utf-8" />
	<meta name="generator" content={Astro.generator} />
	<link rel="icon" href="/favicon.svg" />
	<script src="./_x-calendar-widget.js"></script>
	<title>Turtlemay's Calendar Widget</title>
</head>

<style is:global>
	.site-layout {
		background: paleturquoise;
		display: flex;
		flex-direction: column;
		align-items: safe center;
		justify-content: safe center;
		min-height: 100vh;
	}

	.site-attraction {
		display: flex;
		align-items: safe center;
		justify-content: safe center;
		flex-wrap: wrap;
		gap: 1em;
		padding: 2em;

		.my-cal1 .calendar-widget {
			background: palevioletred;
		}

		.my-cal2 .calendar-widget {
			min-width: 300px;
			min-height: 250px;
		}

		.my-cal3 .calendar-widget {
			background: palegreen;
		}
	}

	.site-main {
		margin: 1em 1em 2em;
		font: 12pt sans-serif;
		background: white;
		max-width: 700px;
		line-height: 1.5;

		> * {
			margin: 2em;
		}

		h1 {
			color: dodgerblue;
		}

		a {
			color: darkorchid;
		}

		pre:has(> code) {
			padding: 1em;
		}
	}

	.site-footer {
		font: 12pt sans-serif;
		margin-bottom: 4em;

		a {
			color: darkgreen;
		}
	}
</style>

<body class="site-layout">
	<div class="site-attraction">
		<x-calendar-widget class="my-cal1" date="Jan 2000"></x-calendar-widget>
		<x-calendar-widget class="my-cal2" id="demoWidget">
			<script is:inline>
				demoWidget.style.cursor = "pointer";
				demoWidget.addEventListener("pointerdown", () => demoWidget.goNextMonth());
			</script>
		</x-calendar-widget>
		<x-calendar-widget class="my-cal3" date="Dec 3000"></x-calendar-widget>
	</div>
	<main class="site-main">
		<slot />
	</main>
	<footer class="site-footer">
		Made by
		<a href="/">Turtlemay</a>
	</footer>
</body>
