---
interface Props {
	opener: string;
}
---

<style>
	dialog {
		padding: 5px;
		box-shadow: 0px 12px 0px -6px #000;
		border: 1px solid #000;
	}

	.content {
		border: 3px solid #000;
	}
</style>

<dialog is="x-site-modal" data-opener={Astro.props.opener}>
	<div class="content">
		<slot />
	</div>
</dialog>

<script>
	customElements.define(
		"x-site-modal",
		class extends HTMLDialogElement {
			connectedCallback() {
				this.addEventListener("DIALOG_CLOSE", () => this.close());

				document.body.addEventListener("click", (event) => {
					const el = event.target as HTMLElement;
					if (el.matches(`${this.dataset.opener}`)) {
						event.preventDefault();
						this.showModal();
					}
				});
			}
		},
		{ extends: "dialog" },
	);
</script>
