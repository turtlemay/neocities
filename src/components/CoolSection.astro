---
interface Props {
	title?: string;
}
---

<style>
	.cool-section {
		margin: 1em 0;
		border: 1px dotted #333;
		border-top: 0;
	}

	.heading {
		display: flex;
		align-items: start;
		background: white;
		padding: 0 1px;
		> :only-child {
			display: block;
			padding: 0 2px;
			margin-top: -0.5em;
		}
		&::before {
			content: "";
			display: block;
			width: 10px;
			border-bottom: 1px dotted #333;
		}
		&::after {
			content: "";
			display: block;
			flex: 1;
			border-bottom: 1px dotted #333;
		}
	}

	.content {
		padding: 10px;
	}
</style>

<div class="cool-section">
	<div class="heading" role="heading">
		<slot name="title">
			<div class="text">{Astro.props.title}</div>
		</slot>
	</div>
	<div class="content">
		<slot />
	</div>
</div>
